# ── 前端可讀（公開安全）───────────────────────────────
# Supabase Project URL 與 Publishable key（安全可公開，會進前端 bundle）
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# ── 只在伺服器端讀取（機密！絕不能進前端）─────────────
# Claude Code Routine 的 fire endpoint 與 API token
# 只會被 /api/trigger-scoring 這個 Serverless Function 用 process.env 讀取
ROUTINE_FIRE_URL=https://api.anthropic.com/v1/claude_code/routines/YOUR_ROUTINE_ID/fire
ROUTINE_API_TOKEN=sk-ant-oat01-xxxxxxxxxxxx
